# Kopyalayın: cp .env.example .env

# Model eşikleri
CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.5

# Önceliklendirme
MERGE_RADIUS_M=15
POI_RADIUS_M=150
POI_BONUS=0.1
# Fen İşleri'nin belirleyeceği sınıf ağırlıkları (JSON)
# CLASS_WEIGHTS={"D40": 1.0, "D20": 0.8, "D10": 0.5, "D00": 0.4}

# Sabit araç kamerası kalibrasyonu: piksel -> zemin (metre) 3x3 homografi (JSON). Boşsa alan oranı kullanılır.
# CAMERA_HOMOGRAPHY=[[...],[...],[...]]

# Bursa test seti için Mapillary Client Token (scripts/fetch_mapillary_bursa.py)
MAPILLARY_TOKEN=

# Yönetici girişi (iş takip paneli). Boşsa giriş kapalıdır: yalnızca yerel geliştirme için.
# Şifre düz metin ya da özet olabilir; özet üretmek için: python -m app.auth  (özeti tek tırnak içine yazın)
ADMIN_PASSWORD=
# Birden çok personel: ADMIN_USERS=ali:sifre1,veli:sifre2
# Oturum çerezini imzalayan anahtar; boşsa her yeniden başlatmada oturumlar kapanır. Üretmek için: openssl rand -hex 32
SECRET_KEY=
# SESSION_HOURS=12

# Telefonların erişeceği genel HTTPS adresi (tünel vb.); paneldeki QR kod bunu gösterir
# PUBLIC_URL=https://ornek.trycloudflare.com

# KVKK
RETENTION_DAYS=90
# Plaka/yüz için özel eğitilmiş YOLO modeli (opsiyonel)
# PRIVACY_MODEL_PATH=/app/models/plate_face.pt
